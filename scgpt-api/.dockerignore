__pycache__
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache
.mypy_cache
.ruff_cache
.venv
venv
env
.env
.git
.gitignore
.idea
.vscode
*.swp
*.swo

# Don't bake huge runtime data into the image.
cache/downloaded_datasets/*
!cache/downloaded_datasets/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep

# The model weights are mounted at runtime (typically from Azure Files or a
# PersistentVolume). Bundling them into the image bloats it by ~1.5 GB and
# leaks the checkpoint into every registry layer.
save/scGPT_human/*
!save/scGPT_human/.gitkeep

# Docs / dev-only files.
README.md
docs/
tests/
notebooks/
